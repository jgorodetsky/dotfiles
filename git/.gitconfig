# behavior only — NO identity here. this file is INCLUDED from your real ~/.gitconfig
# (install.sh adds the include line), so your global identity + creds live in ~/.gitconfig
# and are never written into this tracked repo.

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[credential]
	helper = osxkeychain
# github auth goes through gh: browser login once (gh auth login), token kept in the keychain.
# the empty helper clears osxkeychain for these hosts so gh is the only one asked.
# PATH is set so gui apps that launch git without homebrew on PATH still find gh.
[credential "https://github.com"]
	helper =
	helper = !PATH=/opt/homebrew/bin:/usr/local/bin:$PATH gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !PATH=/opt/homebrew/bin:/usr/local/bin:$PATH gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:

# diffs you read on screen are drawn by delta (brew git-delta): gd, gds, git show, git add -p, lazygit.
# plain less when delta isn't installed. scripts and agents still get plain patches, since git only
# runs the pager when output goes to a terminal. an s in front of a diff alias (sgds) shows it side by side
[core]
	pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then exec delta --color-only; else exec cat; fi"
[delta]
	navigate = true
	line-numbers = true
