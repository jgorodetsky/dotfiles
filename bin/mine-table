#!/usr/bin/env bash
# mine-table - the engine behind `mine`. reads your aliases + functions (name, type, runs/what) on stdin,
# merges them with shell/mine.tsv (tools, keys, and notes), filters by the words given, and draws
# the result with boxtable. piped, it prints plain tab-separated rows instead.
#   mine                  everything, a-z
#   mine bat eza tldr     just those (commas fine). an exact name, else names starting with it
#                         (aws -> every aws thing), or what it replaces (cd, ls, git, kubectl)
#   mine --edit           open shell/mine.tsv to add a tool or a note
set -euo pipefail

DIR="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$DIR/shell/mine.tsv"
case "${1:-}" in
  -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  -e|--edit) exec ${EDITOR:-vim} "$DATA" ;;
esac

rows="$(awk -F'\t' -v OFS='\t' -v args="$(printf '%s ' "$@" | tr ',' ' ')" '
function words(s, out,   n, i, t, k) {   # names: split on spaces, commas, parens
  n = split(tolower(s), t, /[ ,()]+/); k = 0
  for (i = 1; i <= n; i++) if (t[i] != "") out[++k] = t[i]
  return k
}
# file 1 (stdin): auto rows from the shell. alias: name, alias, command. function: name, function, description
FILENAME == "-" { if (NF) { auto[$1] = 1; atype[$1] = $2; aval[$1] = $3; order[++na] = $1 } next }
# file 2: mine.tsv
/^#/ || NF == 0 { next }
!seen_head { seen_head = 1; next }
{ ntype[$1] = $2; nrep[$1] = $3; nwhat[$1] = $4; ntry[$1] = $5
  if ($2 == "tool" || $2 == "key") order[++na] = $1 }
END {
  for (k = 1; k <= na; k++) { n = order[k]; rows++
    name[rows] = n
    if (n in auto) {
      type[rows] = atype[n]
      if (atype[n] == "alias") { rep[rows] = aval[n]; what[rows] = nwhat[n] }
      else { rep[rows] = nrep[n]; what[rows] = (nwhat[n] != "" ? nwhat[n] : aval[n]) }
      try[rows] = ntry[n]
    } else { type[rows] = ntype[n]; rep[rows] = nrep[n]; what[rows] = nwhat[n]; try[rows] = ntry[n] }
  }
  nq = split(tolower(args), q, / +/); keep = 0
  for (j = 1; j <= nq; j++) {
    if (q[j] == "") continue
    hit = 0; exact = 0                     # exact name wins; else names starting with it
    for (r = 1; r <= rows; r++) { m = words(name[r], w); for (i = 1; i <= m; i++) if (w[i] == q[j]) exact = 1 }
    for (r = 1; r <= rows; r++) {
      ok = 0; m = words(name[r], w)
      for (i = 1; i <= m && !ok; i++) ok = exact ? (w[i] == q[j]) : (index(w[i], q[j]) == 1)
      if (!ok) { split(tolower(rep[r]), rp, / /); ok = (rp[1] == q[j]) }   # what it replaces: cd, ls, git...
      if (ok) { hit = 1; picked[r] = 1 }
    }
    if (!hit) printf "mine: nothing for \"%s\" on your setup. for the public docs try: tldr %s\n", q[j], q[j] > "/dev/stderr"
    any = 1
  }
  print "name", "type", "replaces / runs", "what it does", "try this"
  for (r = 1; r <= rows; r++) if (!any || (r in picked)) { print name[r], type[r], rep[r], what[r], try[r]; shown++ }
  if (any && !shown) exit 1
}' - "$DATA")" || exit 1

if [ -t 1 ]; then printf '%s\n' "$rows" | "$DIR/bin/boxtable"
else printf '%s\n' "$rows" | { IFS= read -r h; printf '%s\n' "$h"; LC_ALL=C sort -f -s -t$'\t' -k1,1; }; fi
