#!/usr/bin/env bash
# tldrmy - tldr for your own setup: the tools these dotfiles add and what they replace.
#   tldrmy                the whole table
#   tldrmy bat eza tldr   just those rows (commas are fine). an exact tool name, else names starting
#                         with it (aws -> every aws tool), or what it replaces (cd, ls, git, kubectl)
#   tldrmy --edit         open the table file to add or change a row
set -euo pipefail

DATA="$(cd "$(dirname "$0")/.." && pwd)/shell/tldrmy.tsv"
case "${1:-}" in
  -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  -e|--edit) exec ${EDITOR:-vim} "$DATA" ;;
esac

width="${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}"
color=0; [ -t 1 ] && color=1

awk -F'\t' -v args="$(printf '%s ' "$@" | tr ',' ' ')" -v width="$width" -v color="$color" '
function words(s, out,   n, i, t, k) {   # tool names: split on spaces, commas, parens
  n = split(tolower(s), t, /[ ,()]+/); k = 0
  for (i = 1; i <= n; i++) if (t[i] != "") out[++k] = t[i]
  return k
}
/^#/ || NF == 0 { next }
!have_head { for (i = 1; i <= 4; i++) head[i] = $i; have_head = 1; next }
{ rows++; for (i = 1; i <= 4; i++) cell[rows, i] = $i }
END {
  nq = split(tolower(args), q, / +/); keep = 0
  for (j = 1; j <= nq; j++) {
    if (q[j] == "") continue
    hit = 0; exact = 0                     # exact tool name wins; else names starting with it
    for (r = 1; r <= rows; r++) { n = words(cell[r, 1], w); for (i = 1; i <= n; i++) if (w[i] == q[j]) exact = 1 }
    for (r = 1; r <= rows; r++) {
      ok = 0; n = words(cell[r, 1], w)
      for (i = 1; i <= n && !ok; i++) ok = exact ? (w[i] == q[j]) : (index(w[i], q[j]) == 1)
      if (!ok) { split(tolower(cell[r, 2]), rep, / /); ok = (rep[1] == q[j]) }   # what it replaces: cd, ls, git...
      if (ok) { hit = 1; if (!(r in picked)) { picked[r] = 1; order[++keep] = r } }
    }
    if (!hit) printf "tldrmy: nothing for \"%s\" on your setup. for the public docs try: tldr %s\n", q[j], q[j] > "/dev/stderr"
  }
  if (nq == 0 || args ~ /^ *$/) for (r = 1; r <= rows; r++) order[++keep] = r
  if (keep == 0) exit 1

  B = color ? "\033[1m" : ""; C = color ? "\033[1;36m" : ""; D = color ? "\033[2m" : ""; X = color ? "\033[0m" : ""
  for (i = 1; i <= 4; i++) wid[i] = length(head[i])
  for (k = 1; k <= keep; k++) for (i = 1; i <= 4; i++) if (length(cell[order[k], i]) > wid[i]) wid[i] = length(cell[order[k], i])
  total = wid[1] + wid[2] + wid[3] + wid[4] + 9

  if (total <= width) {                    # fits: a real table
    printf "%s%-*s   %-*s   %-*s   %s%s\n", B, wid[1], head[1], wid[2], head[2], wid[3], head[3], head[4], X
    line = ""; for (i = 1; i < total; i++) line = line "-"; print D line X
    for (k = 1; k <= keep; k++) { r = order[k]
      printf "%s%-*s%s   %-*s   %-*s   %s\n", C, wid[1], cell[r, 1], X, wid[2], cell[r, 2], wid[3], cell[r, 3], cell[r, 4] }
  } else {                                 # narrow terminal: one card per tool
    for (k = 1; k <= keep; k++) { r = order[k]
      printf "%s%s%s", C, cell[r, 1], X
      if (cell[r, 2] != "-") printf "  %sreplaces %s%s", D, cell[r, 2], X
      printf "\n  %s\n  %stry:%s %s\n\n", cell[r, 3], D, X, cell[r, 4] }
  }
}' "$DATA"
